        "summary": "下载/预览（属主谓词）",
        "tags": [
          "attachments"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "凭据错误统一 401 AUTH_001；连续 5 次失败后锁定 423 AUTH_002（details.retryAfterMinutes）",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseAuthResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "登录",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "删除会话行，204",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "登出（需登录）",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "description": "失效 401 AUTH_003；账号脱敏展示",
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseMeResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "当前会话（需登录）",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "description": "重复注册 409 AUTH_004；格式错误 422 AUTH_005",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseAuthResponse"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "注册并自动登录",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health",
