        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseInvoiceView"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "编辑发票（F05，M2）",
        "tags": [
          "invoices"
        ]
      }
    },
