# 运行层：jar 由 CI/本地预先构建（server/../target/server-*.jar）
FROM eclipse-temurin:25-jre-alpine
WORKDIR /app
COPY server-0.1.0-SNAPSHOT.jar app.jar
# JVM 预算（tech-stack §6.2）：容器 768MB limit，堆 60%，SerialGC（小堆更省）
ENV JAVA_OPTS="-XX:MaxRAMPercentage=60 -XX:+UseSerialGC -XX:MaxMetaspaceSize=128m"
RUN mkdir -p /data/attachments
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://localhost:8080/api/v1/health || exit 1
ENTRYPOINT ["sh","-c","java $JAVA_OPTS -jar app.jar"]
